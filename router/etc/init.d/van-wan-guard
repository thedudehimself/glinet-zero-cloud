#!/bin/sh /etc/rc.common
# OpenWrt procd init script for van-wan-guard.

START=95
STOP=10
USE_PROCD=1

start_service() {
    mkdir -p /var/run/van-wan-guard /etc/van-wan-guard
    procd_open_instance
    procd_set_param command /bin/sh /usr/libexec/van-wan-guard/daemon.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
